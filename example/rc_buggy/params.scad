/* =====================================================================
   RC 오프로드 버기 (1:10) — 전역 파라미터
   단위: mm | 바닥면 z=0 | +Z 위 | +Y 전진 | +X 우측
   주요 치수는 이 파일 하나에서 일괄 수정 가능
   ===================================================================== */
$fn      = 64;    // 기본 곡면 해상도
rod_fn   = 48;    // 구조 튜브(캡슐) 해상도
wheel_fn = 96;    // 휠 원주 해상도
coil_fn  = 48;    // 쇼크 스프링 링 해상도

/* ------------------ 차량 기준 치수 ------------------ */
L_total   = 400;             // 전장
W_total   = 250;             // 전폭
WB        = 260;             // 휠베이스
wheel_dia = 110;             // 휠 외경(트레드 블록 포함)
wheel_r   = wheel_dia / 2;

/* ------------------ 섀시 플레이트 ------------------ */
chassis_z_bot   = 50;                        // 섀시 하면 높이(스키드 기준 지상고)
chassis_t       = 4;                         // 플레이트 두께
chassis_z_top   = chassis_z_bot + chassis_t;
chassis_hw      = 70;                        // 기본 반폭
chassis_taper_y = 140;                       // 앞뒤 테이퍼 시작 |y|
chassis_y_f     =  172;  chassis_hw_f = 55;  // 프런트 끝 (y, 반폭)
chassis_y_r     = -172;  chassis_hw_r = 58;  // 리어 끝   (y, 반폭)
rail_w = 8;  rail_h = 6;                     // 측면 강화 레일 단면

/* ------------------ 휠 / 타이어 ------------------ */
tire_w_f = 42;   hub_f_x = 104;   axle_f_y =  130;   // 프런트: 폭/허브x/액슬y
tire_w_r = 50;   hub_r_x = 100;   axle_r_y = -130;   // 리어(와이드)
hub_z    = wheel_r;                             // 허브 높이 = 접지
tire_carcass_r = 52.5;   // 카카스 외경 반지름(블록 돋음 전)
tire_bore_r    = 36;     // 타이어 내경 = 림 시트 반지름
tread_n     = 20;        // 트레드 블록 개수(행당)
tread_depth = 2.5;       // 블록 돋음 → 외경 110mm
tread_len   = 9;         // 블록 접선방향 길이
tread_w     = 8.5;       // 블록 축방향 폭
rim_wall = 3;  rim_gap = 0.4;  bead_t = 2.5;
hub_disc_r = 17;

/* ------------------ 롤 케이지 (6포인트) ------------------ */
tube_od   = 9;     // 메인 튜브 외경
tube_od_s = 7;     // 보조 튜브 외경
cage_fx = 58; cage_fy =  42;  cage_ft = [56,  38, 112]; // 프런트 후프 발(x,y)→상단
cage_mx = 58; cage_my = -48;  cage_mt = [55, -48, 128]; // 메인 후프
cage_sx = 52; cage_sy = -98;                            // 리어 스테이 발
foot_t = 5;                                             // 발판 두께

/* ------------------ 서스펜션 (더블 위시본) ------------------ */
arm_od     = 7;      // A-arm 튜브 외경
bush_od    = 10;     // 피벗 부싱 외경
lwr_bush_x = 75.5;   // 로어 부싱 x(섀시 측면 외측)
lwr_dy     = 12;     // 로어 부싱 y 오프셋(액슬 기준)
lwr_z      = 50;     // 로어 아암 높이
knk_f      = 100;    // 프런트 너클 x
knk_r      = 96;     // 리어 너클 x
upr_piv_x  = 56;     // 어퍼 피벗 타워 x
upr_z      = 72;     // 어퍼 아암 높이
tower_fx = 47; tower_fy =  107; tower_top = 99;  // 프런트 쇼크 타워
tower_rx = 47; tower_ry = -151;                  // 리어 쇼크 타워
shock_body_od = 9;  shock_rod_od = 3.5;
spring_R = 6.5;  spring_t = 2.0;  spring_n = 6;

/* ------------------ 파워트레인 ------------------ */
eng_hw=35;  eng_yf=-68;   eng_yr=-110;  eng_top=88;         // 엔진 블록(yf=앞, yr=뒤)
head_hw=30; head_yf=-84;  head_yr=-112;  head_top=100;      // 실린더 헤드
rad_hw=50;  rad_y0=155;   rad_y1=165;  rad_z0=77; rad_z1=109; // 라디에이터

/* ------------------ 공통 ------------------ */
gap = 0.4;                    // 부품 간 결합 클리어런스
z0  = chassis_z_top + gap;    // 섀시 위에 올라가는 부품의 기준 하면
