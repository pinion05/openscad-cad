/* =====================================================================
   리얼 스케일 오프로드 버기 (1:1, 단위 mm) — 전역 파라미터
   스타일: Ariel Nomad × RZR × 클래식 듄 버기 (튜브 프레임 + 노출 서스펜션)
   좌표계: 바닥 z=0 | +Z 위 | +Y 전진 | +X 우측 | 원점 = 휠베이스·트레드 중심

   [Y존 예산]  프론트범퍼 1500~1700 | 프론트휠 705~1595(액슬 +1150)
              후드/노즈 330~1180 | 라디에이터 1395~1455 | 코크핏 -350~300
              엔진 -960~-460 | 트랜스 -1120~-860 | 리어휠 -705~-1595(액슬 -1150)
              카고랙 -1700~-1140 | 머플러 -1600~-1250 | 연료셀 -1620~-1500
   [X통로]    중앙(프롭/터널) |x|<90 | 프레임 레일 x=±560 | 아암 통로 420~620
              휠 640~960(허브 800) | 펜더쉘 648~985
   [Z존]      지상고 350(스키드 하면) | 레일 380 | 플로어 396~412 | 로어암 500
              액슬/하프샤프트 445 | 어퍼암 790 | 후드 960~1010 | A후프탑 1450
              B후프탑 1620 (전고 1642)
   ===================================================================== */
$fn      = 48;      // 기본 곡면 해상도
rod_fn   = 36;      // 구조 튜브(캡슐) 해상도
wheel_fn = 120;     // 휠 원주 해상도
coil_fn  = 36;      // 코일 링 해상도

/* ------------------ 차량 기준 치수 (실차 사양) ------------------ */
L_total   = 3400;              // 전장
WB        = 2300;              // 휠베이스
axle_y    = 1150;              // 액슬 y (전 +1150 / 후 -1150)
wheel_r   = 445;               // 타이어 외경 890 (35인치)
wheel_dia = wheel_r * 2;
clr       = 350;               // 최저 지상고 (스키드 하면)

/* ------------------ 프레임 (공간 튜브) ------------------ */
rail_x  = 560;                 // 사이드 레일 x
rail_z  = 380;                 // 레일 중심 높이 (하면 358)
rail_od = 44;                  // 메인 튜브 외경
tube_sub = 30;                 // 보조 튜브 외경
floor_z0 = 396;  floor_t = 16; floor_z1 = floor_z0 + floor_t;   // 플로어 396~412
mid_z   = 820;                 // 미들 레일(도어 빔 보조) 높이
cross_y = [1520, 1290, 1010, 760, 300, -350, -750, -1010, -1290, -1500];
skid_hw = 420;  skid_t = 8;    // 하부 스키드 플레이트

/* ------------------ 휠 / 타이어 ------------------ */
hub_x  = 800;                  // 허브 x (트레드 1600)
tire_w_f = 260;                // 프런트 타이어 폭
tire_w_r = 320;                // 리어 타이어 폭
tire_carcass_r = 420;          // 카카스 외경 r (블록 돋음 전)
tire_bore_r    = 216;          // 림 시트 r (17인치 림)
tread_n = 26;  tread_depth = 25;  tread_len = 60;  tread_w = 55;
rim_wall = 22;  rim_gap = 0.4;  bead_t = 30;
hub_disc_r = 110;  spoke_n = 6;

/* ------------------ 롤케이지 ------------------ */
cage_od = 44;  cage_foot_t = 14;  foot_w = 90;
a_foot = [545, 520];                       // A후프(윈드실드) 발 [x,y]
a_sh   = [545, 380, 1050];                 // A후프 어깨
a_top  = [480, 150, 1450];                 // A후프 탑
b_foot = [545, -420];                      // B후프(메인) 발
b_top  = [525, -430, 1620];                // B후프 탑 (전고 1642)
stay_foot = [555, -1560];                  // 리어 스테이 발
ws_bar_z = 930;                            // 윈드실드 하단 바 높이

/* ------------------ 서스펜션 (더블 위시본) ------------------ */
arm_od  = 36;   bush_od = 48;   ball_od = 60;
lwr_z = 500;  lwr_dy = 105;     // 로어 피벗 높이 / 액슬 기준 y 오프셋
upr_z = 790;  upr_dy = 95;      // 어퍼 피벗 (부싱 x=370, 인보드 빔 마운트)
brk_x0 = 420;  brk_x1 = 510;    // 피벗 브래킷 판 x범위 (프레임 부품)
knk_x_f = 620;  knk_x_r = 600;  // 너클 x
knk_z0 = 440;   knk_z1 = 800;   knk_od = 48;
stub_x1 = 845;  stub_od = 60;   // 허브 스터브 (x 610~845)
disc_r  = 190;                  // 브레이크 디스크 외경 r
shock_top_f = [420,   950, 1090];   shock_bot_f = [554,  1198, 530];
shock_top_r = [430, -1035,  990];   shock_bot_r = [536, -1105, 535];
shock_body_od = 95;  shock_rod_od = 38;
spring_R = 55;  spring_t = 18;  spring_n = 7;
rack_z = 520;  rack_y = 960;   rack_hw = 390;  rack_od = 44;

/* ------------------ 파워트레인 (미드 세로형) ------------------ */
eng_y0 = -860;  eng_y1 = -460;  eng_hw = 210;   // 엔진 블록
eng_z0 = 500;   eng_z1 = 790;
head_hw = 185;  head_z1 = 870;                   // 실린더 헤드
itb_y  = [-530, -630, -730, -830];  itb_od = 60; // 스로틀 스택
trans_y0 = -1120; trans_y1 = -860; trans_hw = 160; trans_z0 = 460; trans_z1 = 680;
diff_r = 80;                                     // 디퍼렌셜 케이스 r
prop_od = 44;                                    // 프로필 샤프트
hs_od   = 38;                                    // 하프샤프트
rad_y0 = 1405;  rad_y1 = 1445;  rad_z0 = 700;  rad_z1 = 860;  rad_hw = 300;
muff_x = 280;  muff_y0 = -1600;  muff_y1 = -1280;  muff_z = 620;  muff_od = 160;
fuel_y0 = -1596; fuel_y1 = -1476; fuel_hw = 180; fuel_z0 = 470; fuel_z1 = 650;

/* ------------------ 바디워크 ------------------ */
fen_R0 = 492;  fen_R1 = 506;          // 펜더 아치 반경 (타이어와 47mm 간극)
fen_x0 = 648;  fen_x1_f = 975;  fen_x1_r = 985;
hood_y0 = 330;  hood_y1 = 960;  hood_hw = 470;  hood_z0 = 960;
pod_x0 = 595;   pod_x1 = 635;                          // 사이드 포드
cov_y0 = -960;  cov_y1 = -420;  cov_hw = 495;  cov_z0 = 955;  // 엔진 커버
tail_y = -1620; tail_hw = 230;                          // 테일 패널

/* ------------------ 범퍼 ------------------ */
bump_od = 54;

/* ------------------ 공통 ------------------ */
gap = 0.4;                       // 부품 간 결합 클리어런스
z0  = floor_z1 + gap;            // 플로어 위 부품의 기준 하면 (412.4)
