/* 09. 리어 범퍼 + 카고 랙 — 튜브 후프 + 메시 플랫폼(z904~928) + 경사 다리 +
   스페어 타이어 J후크 (스페어 휠은 조립에서 06 부품 인스턴스로 탑재) */
include <../params.scad>
include <../lib.scad>

module part_bumper_rear() {
    for (s = [-1, 1]) {
        foot(s*450, -1560, w = 70);
        rod([s*450, -1560, 480], [s*640, -1680, 560], bump_od);
    }
    rod([-640, -1680, 560], [640, -1680, 560], bump_od);

    /* 카고 랙 플랫폼 (메시 오픈 3개) — 타워/스테이/테일판과 4mm+ */
    difference() {
        translate([0, -1420, 916]) cube([790, 560, 24], center = true);
        for (yy = [-1250, -1420, -1590])
            translate([0, yy, 916]) cube([640, 90, 40], center = true);
    }
    /* 다리 — 앞다리는 전경사(하프샤프트·어퍼브래킷 회피), 뒷다리 수직 */
    for (s = [-1, 1]) {
        foot(s*160, -1310, w = 40);
        rod([s*160, -1310, 440], [s*160, -1310, 906], 36);
        foot(s*390, -1650, w = 50);
        rod([s*390, -1650, 440], [s*390, -1650, 906], 36);
    }
    /* 스페어 타이어 스탠드오프 4 + J후크 (스페어 하면 z=1048.4) */
    for (sx = [-1, 1], sy = [-1, 1])
        translate([sx*310, -1420 + sy*120, 928]) cylinder(h = 120, d = 50, $fn = 24);
    for (s = [-1, 1])
        rod([s*470, -1420, 928], [s*470, -1420, 1400], 24);
}

part_bumper_rear();
